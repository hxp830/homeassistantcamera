# Copy to .env and fill in your own values. Never commit a real .env.

APP_NAME=gesture-yolo-ha
HOST=0.0.0.0
PORT=8000

# Leave empty to disable authentication (LAN-only use).
# When set, every /api, /snapshot and /stream request requires this token.
# Strongly recommended: uploading a .pt model executes code on load.
API_TOKEN=
MAX_UPLOAD_MB=200

MODEL_DIR=models
# Use "mediapipe_hands" for the built-in engine, or a .pt file inside MODEL_DIR.
MODEL_FILE=best.pt
CONF=0.50
IOU=0.45
IMG_SIZE=640
DETECT_INTERVAL=0.35
# Share one loaded copy of a .pt file across all cameras to save memory.
SHARE_MODELS=true

# SOURCE takes a camera index (0), a device path, or a full stream URL.
# Set it to "auto" to build an RTSP URL from the RTSP_* values below.
SOURCE=0
RTSP_HOST=
RTSP_PORT=
RTSP_USER=
RTSP_PASSWORD=
RTSP_PATH=/

# Preview tuning. Lower quality/width cuts CPU on small boards.
JPEG_QUALITY=80
# 0 keeps the native resolution.
PREVIEW_WIDTH=0
# Cap preview encoding. Detection always runs at full stream rate; this only limits
# how often a JPEG is produced. Lower it when running many cameras on weak hardware.
PREVIEW_FPS=15
# Stop encoding preview frames when nobody has watched for this many seconds.
IDLE_ENCODE_TIMEOUT=15

MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_CLIENT_ID=gesture_yolo_ha
MQTT_DISCOVERY_PREFIX=homeassistant
MQTT_STATE_TOPIC=gesture_yolo_ha/state
MQTT_KEEPALIVE=60
# "change" publishes only when the gesture changes; "always" publishes every detection.
MQTT_PUBLISH_MODE=change
# Republish the current gesture at least this often, in seconds (0 disables).
MQTT_HEARTBEAT=60

# Only needed for the scripts in tools/remote_patches.
REMOTE_HOST=
REMOTE_PORT=22
REMOTE_USER=
REMOTE_PASSWORD=
REMOTE_TG_SCRIPT_PATH=/home/linaro/canva-dreamlab-cli/tg_persistent.py
REMOTE_TG_TMP_PATH=/tmp/tg_persistent.py
REMOTE_GESTURE_PROJECT_DIR=
